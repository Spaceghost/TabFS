## pragmas.nogc = true
## pragmas.noentrypoint = true
## pragmas.nochecks = true
## pragmas.writestderr = 'none'
## pragmas.abort = 'trap'

local F3_POSTSCRIPT_SIZE: uint32 <comptime> = 32
local F3_RESULT_SIZE: uint32 <comptime> = 48

local F3_STATUS_OK: int32 <comptime> = 0
local F3_STATUS_NULL_POINTER: int32 <comptime> = 1
local F3_STATUS_SHORT_BUFFER: int32 <comptime> = 2
local F3_STATUS_FILE_TOO_SMALL: int32 <comptime> = 3
local F3_STATUS_BAD_MAGIC: int32 <comptime> = 4
local F3_STATUS_BAD_LAYOUT: int32 <comptime> = 5
local F3_STATUS_UNSUPPORTED_COMPRESSION: int32 <comptime> = 6
local F3_STATUS_UNSUPPORTED_CHECKSUM: int32 <comptime> = 7

local function load_u16le(bytes: *[0]uint8, offset: usize): uint16
  return (@uint16)(bytes[offset]) |
         ((@uint16)(bytes[offset + 1]) << 8)
end

local function load_u32le(bytes: *[0]uint8, offset: usize): uint32
  return (@uint32)(bytes[offset]) |
         ((@uint32)(bytes[offset + 1]) << 8) |
         ((@uint32)(bytes[offset + 2]) << 16) |
         ((@uint32)(bytes[offset + 3]) << 24)
end

local function load_u64le(bytes: *[0]uint8, offset: usize): uint64
  local value: uint64 = 0
  for i=0,<8 do
    value = value | ((@uint64)(bytes[offset + i]) << (i * 8))
  end
  return value
end

local function store_u16le(out: *[0]uint8, offset: usize, value: uint16)
  out[offset] = (@uint8)(value)
  out[offset + 1] = (@uint8)(value >> 8)
end

local function store_u32le(out: *[0]uint8, offset: usize, value: uint32)
  for i=0,<4 do
    out[offset + i] = (@uint8)(value >> (i * 8))
  end
end

local function store_u64le(out: *[0]uint8, offset: usize, value: uint64)
  for i=0,<8 do
    out[offset + i] = (@uint8)(value >> (i * 8))
  end
end

local function zero_output(out: *[0]uint8)
  for i=0,<F3_RESULT_SIZE do
    out[i] = 0
  end
end

local function abi_version(): uint32 <cexport, codename 'f3_abi_version'>
  return 1
end

local function add_u32(a: uint32, b: uint32): uint32 <cexport, codename 'f3_add_u32'>
  return a + b
end

local function postscript_size(): uint32 <cexport, codename 'f3_postscript_size'>
  return F3_POSTSCRIPT_SIZE
end

local function parse_postscript(bytes: *[0]uint8, length: uint32,
                                file_size: uint64, out: *[0]uint8): int32
                                <cexport, codename 'f3_parse_postscript'>
  if out == nilptr then
    return F3_STATUS_NULL_POINTER
  end
  zero_output(out)
  if bytes == nilptr then
    return F3_STATUS_NULL_POINTER
  end
  if length < F3_POSTSCRIPT_SIZE then
    return F3_STATUS_SHORT_BUFFER
  end
  if file_size < (@uint64)(F3_POSTSCRIPT_SIZE) then
    return F3_STATUS_FILE_TOO_SMALL
  end
  if bytes[30] ~= 70_u8 or bytes[31] ~= 51_u8 then
    return F3_STATUS_BAD_MAGIC
  end

  local metadata_size = load_u32le(bytes, 0)
  local footer_size = load_u32le(bytes, 4)
  local footer_compression = bytes[8]
  local checksum_type = bytes[9]

  if footer_compression > 2 then
    return F3_STATUS_UNSUPPORTED_COMPRESSION
  end
  if checksum_type ~= 0 then
    return F3_STATUS_UNSUPPORTED_CHECKSUM
  end
  if footer_size > metadata_size then
    return F3_STATUS_BAD_LAYOUT
  end

  local available_prefix = file_size - (@uint64)(F3_POSTSCRIPT_SIZE)
  if (@uint64)(metadata_size) > available_prefix then
    return F3_STATUS_BAD_LAYOUT
  end

  local metadata_offset = available_prefix - (@uint64)(metadata_size)
  local footer_offset = available_prefix - (@uint64)(footer_size)
  local data_checksum = load_u64le(bytes, 10)
  local schema_checksum = load_u64le(bytes, 18)
  local major_version = load_u16le(bytes, 26)
  local minor_version = load_u16le(bytes, 28)

  store_u64le(out, 0, metadata_offset)
  store_u64le(out, 8, footer_offset)
  store_u64le(out, 16, data_checksum)
  store_u64le(out, 24, schema_checksum)
  store_u32le(out, 32, metadata_size)
  store_u32le(out, 36, footer_size)
  store_u16le(out, 40, major_version)
  store_u16le(out, 42, minor_version)
  out[44] = footer_compression
  out[45] = checksum_type
  return F3_STATUS_OK
end
